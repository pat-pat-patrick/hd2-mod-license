<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2QD.License.dll: the license plugin of HD2 Mod Quick Deploy (this repository's
       protocol, spec/protocol.zh-CN.md). A panel plugin: it draws its card on the manager's
       Plugins page (Panel.cs), marks the rows of mods that need a license, renews licenses at
       the manager's start, and adds the license commands (Manager.cs). It shares no types with
       the manager: its methods take and give strings, numbers, delegates and Json shapes. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2QD.License</AssemblyName>
    <RootNamespace>Hd2Qd.License</RootNamespace>
    <Version>1.3.1</Version>
    <Product>HD2 Mod License</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)\..=plugin</PathMap>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- the text, one file per language (Lang\<tag>.json), embedded as Lang.<tag>.json: Words.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
